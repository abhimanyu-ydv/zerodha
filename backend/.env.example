# MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers)
MONGO_URL=your_mongodb_connection_string_here

# Any long random string, used to sign session cookies
SESSION_SECRET=replace_with_a_long_random_string

PORT=3002

# Comma-separated list of the frontend and dashboard origins allowed to call the API
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001
